# Copy this file to .env and fill in your values.
# Get SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, SLACK_APP_TOKEN from
# https://api.slack.com/apps -> your app -> Basic Information / OAuth / Socket Mode

SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Your published Google Sheets CSV link (File > Share > Publish to web > CSV)
CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv
